# Feature switches
NEXT_PUBLIC_FEATURE_UPLOAD=true
NEXT_PUBLIC_FEATURE_GOOGLE_AUTH=false

# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_OFFICIAL_PREFIX=gallery/official/
AWS_S3_UPLOADS_PREFIX=uploads/
AWS_CLOUDFRONT_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=
AWS_DYNAMODB_MEDIA_TABLE=geeni-media-items
AWS_DYNAMODB_RATE_LIMITS_TABLE=geeni-rate-limits

# Local AWS credentials (not needed on Amplify/App Runner IAM roles)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google sign-in (used only when NEXT_PUBLIC_FEATURE_GOOGLE_AUTH=true)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
